# Acunetix (server-only — never expose to the browser)
ACUNETIX_BASE_URL=https://ax.yourdomain.com
ACUNETIX_API_KEY=your_acunetix_api_key
# Comma-separated host allowlist (exact host or parent suffix)
ACUNETIX_ALLOWED_HOSTS=ax.yourdomain.com,trycloudflare.com

# Optional: Cloudflare Access service token for the named tunnel
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Dashboard gate — use a PBKDF2 hash in production (see scripts/hash-password.mjs)
DASHBOARD_PASSWORD_HASH=pbkdf2$210000$saltHex$hashHex
# Local bootstrap only (ignored in production when HASH is set):
# DASHBOARD_PASSWORD=local-dev-only

# Session HMAC secret (≥ 32 random characters)
AUTH_SECRET=generate_a_long_random_string_at_least_32_chars

# PC tunnel agent (start/stop cloudflared from the dashboard)
TUNNEL_AGENT_TOKEN=generate_a_long_random_token_shared_with_pc_agent
# Durable live-URL store (GitHub). Needed so Start can publish a new trycloudflare URL.
TUNNEL_STATE_GITHUB_TOKEN=github_pat_with_repo_scope
TUNNEL_STATE_GITHUB_REPO=zarrar79/acunetix-dashboard
# Optional Redis instead of / in addition to GitHub:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
